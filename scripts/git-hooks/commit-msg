#!/usr/bin/env python3
"""Refuse a commit message this repository's own rule refuses.

A message is one line, opens with a Conventional Commits prefix, and stays
within a hundred characters. It carries no body and no trailer, so a reader of
`git log --oneline` sees the whole message every time.

A message the `sdd` tool writes passes untouched. That prefix belongs to the
tool, which composes its own messages, and no rule here applies to them.

A merge, a revert and a cherry-pick pass whatever their message says. Git
composes those, and the repository state says which one is under way rather
than the wording of the subject.

A comment line and the diff `git commit --verbose` appends are not part of the
message and never reach a check.
"""

import os
import re
import subprocess
import sys

PREFIXES = ("feat:", "fix:", "docs:", "chore:", "refactor:", "test:", "perf:", "build:", "ci:")
TOOL_PREFIX = "sdd:"
LIMIT = 100

# Each marks an operation git composes the message for.
COMPOSING = ("MERGE_HEAD", "REVERT_HEAD", "CHERRY_PICK_HEAD")

TRAILER = re.compile(r"^[A-Za-z][A-Za-z-]*: .+$")
SCISSORS = "# ------------------------ >8 ------------------------"


def composing():
    """True while git is finishing a merge, a revert or a cherry-pick."""
    try:
        git_dir = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True,
                                 text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False

    return any(os.path.exists(os.path.join(git_dir, marker)) for marker in COMPOSING)


def message_lines(path):
    """Every line of the message, without comments or the verbose diff."""
    with open(path, encoding="utf-8") as handle:
        raw = handle.read()

    if SCISSORS in raw:
        raw = raw.split(SCISSORS, 1)[0]

    return [line.rstrip("\n") for line in raw.splitlines() if not line.startswith("#")]


def findings(lines):
    """What the message breaks, named one item at a time."""
    body = [line for line in lines if line.strip()]
    if not body:
        return ["the message is empty"]

    subject = body[0]

    if subject.startswith(TOOL_PREFIX):
        return []

    found = []

    if len(body) > 1:
        found.append(f"the message carries {len(body) - 1} line(s) past the subject, and one line "
                     "is the whole message")
        for line in body[1:]:
            if TRAILER.match(line):
                found.append(f"the message carries a trailer: {line}")
                break

    if not subject.startswith(PREFIXES):
        found.append("the subject opens with none of " + ", ".join(PREFIXES))

    if len(subject) > LIMIT:
        found.append(f"the subject runs {len(subject)} characters, past the {LIMIT} allowed")

    return found


def main():
    if len(sys.argv) < 2:
        print("commit-msg: no message file given", file=sys.stderr)
        return 1

    if composing():
        return 0

    found = findings(message_lines(sys.argv[1]))
    if not found:
        return 0

    print("commit-msg refuses this message:", file=sys.stderr)
    for item in found:
        print(f"  - {item}", file=sys.stderr)
    print("\nOne line, a Conventional Commits prefix, 100 characters at most.", file=sys.stderr)

    return 1


if __name__ == "__main__":
    sys.exit(main())
