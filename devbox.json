{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": {
    "nodejs": "24",
    "go": "1.26",
    "go-task": "latest",
    "golangci-lint": "latest",
    "apple-sdk_26": "26.5"
  },
  "shell": {
    "init_hook": [
      "[ -n \"$(git rev-parse --git-dir 2>/dev/null)\" ] && [ -z \"$(git config --get core.hooksPath)\" ] && git config core.hooksPath scripts/git-hooks || true",
      "export PATH=\"$(go env GOPATH)/bin:$PATH\"",
      "./scripts/dev-setup.sh --check"
    ],
    "scripts": {
      "dev": [
        "export SDKROOT=\"$PWD/.devbox/nix/profile/default/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk\"",
        "export CGO_CFLAGS=\"-isysroot $SDKROOT -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET\"",
        "export CGO_LDFLAGS=\"-isysroot $SDKROOT -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET\"",
        "cd source && wails3 task dev"
      ],
      "build": [
        "export SDKROOT=\"$PWD/.devbox/nix/profile/default/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk\"",
        "export CGO_CFLAGS=\"-isysroot $SDKROOT -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET\"",
        "export CGO_LDFLAGS=\"-isysroot $SDKROOT -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET\"",
        "cd source && wails3 task package"
      ],
      "exec": [
        "export SDKROOT=\"$PWD/.devbox/nix/profile/default/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk\"",
        "export CGO_CFLAGS=\"-isysroot $SDKROOT -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET\"",
        "export CGO_LDFLAGS=\"-isysroot $SDKROOT -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET\"",
        "cd source && wails3 task package && ./bin/sddviz.app/Contents/MacOS/sddviz \"$@\""
      ],
      "build:server": "cd source && wails3 task build:server",
      "bindings": "cd source && wails3 task common:generate:bindings",
      "frontend:install": "cd source/frontend && npm install",
      "frontend:lint": "cd source/frontend && npm run lint",
      "frontend:test": "cd source/frontend && npm test",
      "backend:lint": "cd source && go vet ./... && golangci-lint run",
      "backend:test": "cd source && go test -race ./...",
      "test": [
        "devbox run frontend:test",
        "devbox run backend:test"
      ],
      "prose:lint": [
        "{ git ls-files -z -- '*.md' '*.go' '*.ts' '*.tsx' '*.js' '*.css' '*.html' '*.py' '*.sh' '*.yml' '*.yaml'; git ls-files -z --others --exclude-standard -- '*.md' '*.go' '*.ts' '*.tsx' '*.js' '*.css' '*.html' '*.py' '*.sh' '*.yml' '*.yaml'; } | xargs -0 vale"
      ],
      "refs:lint": "python3 scripts/lint/refs.py",
      "lint": [
        "devbox run frontend:lint",
        "devbox run backend:lint",
        "devbox run prose:lint",
        "devbox run refs:lint"
      ],
      "tools": "go install github.com/wailsapp/wails/v3/cmd/wails3@latest",
      "sign": "cd source && wails3 task darwin:sign",
      "sign:notarize": "cd source && wails3 task darwin:sign:notarize"
    }
  },
  "env": {
    "MACOSX_DEPLOYMENT_TARGET": "14.0",
    "SDDVIZ_SIGN_IDENTITY": "Apple Development: Felix Zandanel (ER7AP28HL7)"
  }
}
